# Operation configuration — copy to ~/.dedaverse/operation/.env and edit.
#
# Precedence (highest wins):
#   1. Explicit constructor / CLI arguments
#   2. Existing os.environ values set by the shell
#   3. Entries in this file
#   4. Built-in defaults in deda.core.operation._config
#
# Syntax: KEY=value, one per line. Lines starting with `#` are comments.
# Values may be wrapped in matching quotes (single or double); quotes are
# stripped. Paths support `~` for the user home directory.

# ---- Server ---------------------------------------------------------------

# Loopback interface to bind. Keep this on localhost unless you know what
# you are doing — the server exposes /tick, which forces a task dispatch.
OPERATION_HOST=127.0.0.1

# TCP port for the status / control HTTP server.
OPERATION_PORT=8765

# Heartbeat period, in seconds. The loop wakes every interval, discovers
# tasks, filters runnable ones, and dispatches. Default: 300 (5 minutes).
OPERATION_TICK_INTERVAL_SEC=300

# ---- Filesystem -----------------------------------------------------------

# Task drop-box. Each subdirectory `task<N>/` must contain a `task.md`.
OPERATION_TASKS_DIR=~/.dedaverse/operation/tasks

# Prompt template directory. Defaults to the `templates/` dir that ships
# with the package; override to point at a user-editable location.
# OPERATION_TEMPLATES_DIR=~/.dedaverse/operation/templates

# ---- Copilot CLI ----------------------------------------------------------

# Absolute path to the `copilot` executable. Leave unset to resolve via
# PATH — on Windows this typically ends up at:
#   %APPDATA%\npm\copilot.cmd
# after `npm install -g @github/copilot && copilot auth login`.
# OPERATION_COPILOT_EXECUTABLE=

# Optional model override — passed as `--model <value>` to copilot.
# OPERATION_COPILOT_MODEL=gpt-5

# Pass `--allow-all-tools` to copilot. Convenient for local dev;
# review carefully before enabling in unattended deployments.
OPERATION_COPILOT_ALLOW_ALL_TOOLS=false

# Per-invocation timeout, in seconds, for each `copilot` call.
OPERATION_COPILOT_TIMEOUT_SEC=600
